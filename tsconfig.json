{
  "compilerOptions": {
    "target": "ES2022",
    "module": "es2022",
    "lib": ["ES2022"],
    "types": ["google-apps-script", "node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "removeComments": false,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@adapters/*": ["src/adapters/*"],
      "@core/*": ["src/core/*"],
      "@interfaces/*": ["src/interfaces/*"],
      "@mappers/*": ["src/mappers/*"],
      "@sources/*": ["src/sources/*"],
      "@shared-types/*": ["src/types/*"]
    }
  },
  "include": ["src/**/*"]
}