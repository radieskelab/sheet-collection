{
  "name": "sheet-collection",
  "version": "0.1.0",
  "description": "Typed collection API for Google Sheets and Apps Script",
  "license": "MIT",
  "author": "Eduardo Radieske",
  "type": "commonjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && node build.mjs",
    "watch": "npm run build && esbuild src/index.ts --bundle --outfile=dist/SheetCollection.js --format=iife --target=es2019 --watch",
    "push": "npm run verify && clasp push",
    "pull": "clasp pull",
    "open": "clasp open",
    "login": "clasp login",
    "logout": "clasp logout",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dist": "node tests/test-consumer/index.js",
    "verify": "npm run test && npm run build && npm run test:dist"
  },
  "keywords": [
    "google-apps-script",
    "google-sheets",
    "typescript",
    "orm",
    "nosql",
    "collection",
    "sheetdb"
  ],
  "devDependencies": {
    "@types/google-apps-script": "^2.0.11",
    "@types/jest": "^30.0.0",
    "clasp": "^1.0.0",
    "esbuild": "^0.28.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "allowScripts": {
    "clasp@1.0.0": true,
    "esbuild@0.28.1": true
  }
}
